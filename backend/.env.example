# Copy this file to backend/.env for local development.
# Keep backend/.env out of source control.
DATABASE_URL=postgres://invente25:invente25pw@localhost:5499/invente25
TZ=Asia/Kolkata

# Required for backend-issued staff tokens (RS256). Use literal \n between PEM lines.
# Generate a key with:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF { printf "%s\\n", $0 }'
JWT_PRIVATE_KEY=

# Optional; the backend derives the public key from JWT_PRIVATE_KEY when omitted.
# JWT_PUBLIC_KEY=

# Optional staff-token settings.
# JWT_ISSUER=invente-auth
# JWT_AUDIENCES=invente-admin-api,invente-review-api
# JWT_ACCESS_TTL_SECONDS=864000

# Required for volunteer signup. Use a comma-separated list; add or remove
# addresses here and restart the backend for the change to take effect.
APPROVED_VOLUNTEER_EMAILS=pranav2410215@ssn.edu.in

# Required by the standalone payment OCR worker. The Redis instance belongs
# to the participant payment backend and is reached over the shared network.
REDIS_HOST=invente-redis-dev
REDIS_PORT=6379
REDIS_PASSWORD=
OCR_CONSUMER_NAME=node-worker-1

# Azure AI Document Intelligence resource credentials used by prebuilt-read.
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_API_KEY=
